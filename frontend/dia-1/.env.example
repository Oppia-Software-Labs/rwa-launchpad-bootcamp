# RWA Launchpad frontend: Día 1 environment variables
# Copy to `.env.local` and fill in after the Día 1 contract is deployed.

# Soroban contract id for rwa-launchpad-dia-1. Required for initialize.
# NEXT_PUBLIC_CONTRACT_ID=C...

# Payment token / SAC contract id; prefills the initialize form.
# NEXT_PUBLIC_PAYMENT_TOKEN_ID=C...

# Network name: testnet | public | futurenet (default: testnet)
# NEXT_PUBLIC_NETWORK=testnet

# Optional override; defaults to https://soroban-testnet.stellar.org for testnet.
# NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
